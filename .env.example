# Copy this file to .env and fill in your values.
# .env is gitignored; .env.example is the committed template.
#
# Never paste a key into a commit, a source file, a chat message, or a URL.
# Tools in this repo read keys from .env and pass them in HTTP headers only,
# and redact them from any error output.

# --- Cloud provider (optional) -----------------------------------------------
# Google AI Studio key: https://aistudio.google.com/apikey
# Free tier is roughly 15 requests/minute and 1000/day — benchmark scripts
# throttle and budget-cap themselves to stay under it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Local provider (development default) ------------------------------------
# Requires Ollama running locally. No key needed.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b
