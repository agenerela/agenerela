{
  "description": "EXPERIMENTAL. Four views of one object (front, left, back, right) to a textured 3D model (GLB) with Pixal3D multiview and the TRELLIS.2 VAEs.",
  "source": "Built from workflows/mesh.json with the conditioning of ComfyUI's template 3d_pixal3d_multi_views: each view has its background removed and is cropped to the object, then Pixal3DMultiViewConditioning (fov 20) feeds the multiview model. The MoGe camera estimate is not used. Downstream nodes and their settings are mesh.json's. Needs the mesh_multiview model group, which download_models.py fetches only when named.",
  "params": {
    "front": {
      "targets": [
        [
          "401",
          "image"
        ]
      ],
      "upload": true,
      "required": true,
      "help": "Local path to the front view. The object facing the camera."
    },
    "left": {
      "targets": [
        [
          "402",
          "image"
        ]
      ],
      "upload": true,
      "required": true,
      "help": "Local path to the left view. Camera on the left of the front view: the object's front points to the image's right."
    },
    "back": {
      "targets": [
        [
          "403",
          "image"
        ]
      ],
      "upload": true,
      "required": true,
      "help": "Local path to the back view. Seen from behind."
    },
    "right": {
      "targets": [
        [
          "404",
          "image"
        ]
      ],
      "upload": true,
      "required": true,
      "help": "Local path to the right view. Camera on the right of the front view: the object's front points to the image's left."
    },
    "seed": {
      "targets": [
        [
          "3",
          "seed"
        ],
        [
          "18",
          "seed"
        ],
        [
          "23",
          "seed"
        ],
        [
          "12",
          "seed"
        ]
      ],
      "random": true,
      "help": "Random unless set; applied to all four sampling stages."
    },
    "faces": {
      "targets": [
        [
          "186",
          "target_face_count"
        ]
      ],
      "help": "Triangle budget of the final mesh. Below 50000, also set decimation=qem."
    },
    "decimation": {
      "targets": [
        [
          "186",
          "placement_mode"
        ]
      ],
      "help": "midpoint (the template's) or qem. midpoint broke the mesh at 20000 and 5000 faces; qem held the shape but lands under the budget."
    },
    "texture_size": {
      "targets": [
        [
          "288",
          "value"
        ]
      ],
      "help": "Base colour, metallic and roughness texture size in px."
    },
    "filename_prefix": {
      "targets": [
        [
          "900",
          "filename_prefix"
        ]
      ],
      "help": "Server-side name, e.g. props/barrel."
    },
    "fov": {
      "targets": [
        [
          "298",
          "fov"
        ]
      ],
      "help": "Horizontal field of view of the four views, in degrees. Pixal3D's turnaround sheets use 20."
    }
  },
