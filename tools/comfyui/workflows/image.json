{
  "description": "Text to image with Z-Image Turbo (int8, 8 steps). For concept art, and as the input image for the mesh workflow.",
  "source": "Converted from the official ComfyUI template image_z_image_turbo_int8; node ids match the template's subgraph.",
  "params": {
    "prompt": {
      "targets": [["27", "text"]],
      "required": true,
      "help": "What to draw. For a mesh, ask for ONE object, centred, whole object in view, plain white background."
    },
    "seed": {
      "targets": [["3", "seed"]],
      "random": true,
      "help": "Random unless set. Reuse a seed to reproduce an image."
    },
    "width": {
      "targets": [["13", "width"]],
      "help": "Pixels, a multiple of 16."
    },
    "height": {
      "targets": [["13", "height"]],
      "help": "Pixels, a multiple of 16."
    },
    "steps": {
      "targets": [["3", "steps"]],
      "help": "Turbo is tuned for 8."
    },
    "filename_prefix": {
      "targets": [["9", "filename_prefix"]],
      "help": "Server-side name, e.g. props/barrel."
    }
  },
  "prompt": {
    "28": {
      "class_type": "UNETLoader",
      "inputs": {
        "unet_name": "z_image_turbo_int8_convrot.safetensors",
        "weight_dtype": "default"
      }
    },
    "30": {
      "class_type": "CLIPLoader",
      "inputs": {
        "clip_name": "qwen_3_4b_fp8_mixed.safetensors",
        "type": "lumina2",
        "device": "default"
      }
    },
    "29": {
      "class_type": "VAELoader",
      "inputs": {
        "vae_name": "ae.safetensors"
      }
    },
    "11": {
      "class_type": "ModelSamplingAuraFlow",
      "inputs": {
        "model": ["28", 0],
        "shift": 3.0
      }
    },
    "27": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "clip": ["30", 0],
        "text": ""
      }
    },
    "33": {
      "class_type": "ConditioningZeroOut",
      "inputs": {
        "conditioning": ["27", 0]
      }
    },
    "13": {
      "class_type": "EmptySD3LatentImage",
      "inputs": {
        "width": 1024,
        "height": 1024,
        "batch_size": 1
      }
    },
    "3": {
      "class_type": "KSampler",
      "inputs": {
        "model": ["11", 0],
        "positive": ["27", 0],
        "negative": ["33", 0],
        "latent_image": ["13", 0],
        "seed": 0,
        "steps": 8,
        "cfg": 1.0,
        "sampler_name": "res_multistep",
        "scheduler": "simple",
        "denoise": 1.0
      }
    },
    "8": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": ["3", 0],
        "vae": ["29", 0]
      }
    },
    "9": {
      "class_type": "SaveImage",
      "inputs": {
        "images": ["8", 0],
        "filename_prefix": "agenerela/image"
      }
    }
  }
}
