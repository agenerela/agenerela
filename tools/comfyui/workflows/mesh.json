{
  "description": "Image to textured 3D model (GLB with PBR textures and a baked normal map) with Pixal3D and the TRELLIS.2 VAEs.",
  "source": "Converted from the official ComfyUI template 3d_pixal3d_trellis2_image_to_model, Pixal3D branch only, preview nodes removed, saved with SaveGLB. Node ids match the template. Defaults are lighter than the template's for game use: 50k faces instead of 700k, 2048 px textures instead of 4096. DecimateMesh also carries qem's settings, at their defaults, so the decimation param can switch to it; midpoint ignores them.",
  "params": {
    "image": {
      "targets": [["122", "image"]],
      "upload": true,
      "required": true,
      "help": "Local path to an image of ONE object, whole and centred. Uploaded for you."
    },
    "seed": {
      "targets": [["3", "seed"], ["18", "seed"], ["23", "seed"], ["12", "seed"]],
      "random": true,
      "help": "Random unless set; applied to all four sampling stages."
    },
    "faces": {
      "targets": [["186", "target_face_count"]],
      "help": "Triangle budget of the final mesh. Below 50000, also set decimation=qem."
    },
    "decimation": {
      "targets": [["186", "placement_mode"]],
      "help": "midpoint (the template's) or qem. midpoint broke the mesh at 20000 and 5000 faces; qem held the shape but lands under the budget."
    },
    "texture_size": {
      "targets": [["288", "value"]],
      "help": "Base colour, metallic and roughness texture size in px."
    },
    "remove_background": {
      "targets": [["248", "switch"]],
      "help": "Cut the object out first. Turn off only for images that already have a transparent background."
    },
    "filename_prefix": {
      "targets": [["900", "filename_prefix"]],
      "help": "Server-side name, e.g. props/barrel."
    }
  },
  "prompt": {
    "122": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "set-by-the-image-param.png"
      }
    },
    "193": {
      "class_type": "LoadBackgroundRemovalModel",
      "inputs": {
        "bg_removal_name": "birefnet.safetensors"
      }
    },
    "192": {
      "class_type": "RemoveBackground",
      "inputs": {
        "bg_removal_model": ["193", 0],
        "image": ["122", 0]
      }
    },
    "248": {
      "class_type": "ComfySwitchNode",
      "inputs": {
        "switch": true,
        "on_false": ["122", 1],
        "on_true": ["192", 0]
      }
    },
    "312": {
      "class_type": "ImageCropToMask",
      "inputs": {
        "images": ["122", 0],
        "masks": ["248", 0],
        "width": 1024,
        "height": 1024,
        "pad_factor": 1.1,
        "grow_mask": 0,
        "background": "#000000"
      }
    },
    "55": {
      "class_type": "LoadMoGeModel",
      "inputs": {
        "model_name": "moge_2_vitl_normal_fp16.safetensors"
      }
    },
    "56": {
      "class_type": "MoGeInference",
      "inputs": {
        "moge_model": ["55", 0],
        "image": ["312", 0],
        "resolution_level": 9,
        "fov_x_degrees": 0.0,
        "batch_size": 4,
        "force_projection": true,
        "apply_mask": true,
        "refine_steps": 3
      }
    },
    "242": {
      "class_type": "MoGeGeometryToFOV",
      "inputs": {
        "moge_geometry": ["56", 0],
        "axis": "horizontal",
        "unit": "degrees"
      }
    },
    "15": {
      "class_type": "CLIPVisionLoader",
      "inputs": {
        "clip_name": "dino_v3_L_naf_fp32.safetensors"
      }
    },
    "298": {
      "class_type": "Pixal3DConditioning",
      "inputs": {
        "clip_vision_model": ["15", 0],
        "image": ["312", 0],
        "camera_angle_x": ["242", 0]
      }
    },
    "319": {
      "class_type": "UNETLoader",
      "inputs": {
        "unet_name": "pixal3d_int8_convrot.safetensors",
        "weight_dtype": "default"
      }
    },
    "199": {
      "class_type": "CFGOverride",
      "inputs": {
        "model": ["319", 0],
        "cfg": 1.0,
        "start_percent": 0.667,
        "end_percent": 1.0
      }
    },
    "125": {
      "class_type": "RescaleCFG",
      "inputs": {
        "model": ["199", 0],
        "multiplier": 0.7
      }
    },
    "108": {
      "class_type": "ModelSamplingSD3",
      "inputs": {
        "model": ["125", 0],
        "shift": 5.0
      }
    },
    "87": {
      "class_type": "EmptyTrellis2LatentStructure",
      "inputs": {
        "batch_size": 1
      }
    },
    "3": {
      "class_type": "KSampler",
      "inputs": {
        "model": ["108", 0],
        "positive": ["298", 0],
        "negative": ["298", 1],
        "latent_image": ["87", 0],
        "seed": 0,
        "steps": 12,
        "cfg": 7.5,
        "sampler_name": "euler",
        "scheduler": "normal",
        "denoise": 1.0
      }
    },
    "117": {
      "class_type": "VAELoader",
      "inputs": {
        "vae_name": "trellis_2_shape_vae_bf16.safetensors"
      }
    },
    "119": {
      "class_type": "VaeDecodeStructureTrellis2",
      "inputs": {
        "samples": ["3", 0],
        "vae": ["117", 0],
        "resolution": "32"
      }
    },
    "91": {
      "class_type": "Trellis2ShapeStage",
      "inputs": {
        "positive": ["298", 0],
        "negative": ["298", 1],
        "voxel": ["119", 0]
      }
    },
    "279": {
      "class_type": "CFGOverride",
      "inputs": {
        "model": ["319", 0],
        "cfg": 1.0,
        "start_percent": 0.769,
        "end_percent": 1.0
      }
    },
    "126": {
      "class_type": "RescaleCFG",
      "inputs": {
        "model": ["279", 0],
        "multiplier": 0.5
      }
    },
    "18": {
      "class_type": "KSampler",
      "inputs": {
        "model": ["126", 0],
        "positive": ["91", 0],
        "negative": ["91", 1],
        "latent_image": ["91", 2],
        "seed": 0,
        "steps": 20,
        "cfg": 7.5,
        "sampler_name": "euler",
        "scheduler": "normal",
        "denoise": 1.0
      }
    },
    "94": {
      "class_type": "Trellis2UpsampleStage",
      "inputs": {
        "positive": ["91", 0],
        "negative": ["91", 1],
        "shape_latent": ["18", 0],
        "vae": ["117", 0],
        "target_resolution": 1536
      }
    },
    "23": {
      "class_type": "KSampler",
      "inputs": {
        "model": ["126", 0],
        "positive": ["94", 0],
        "negative": ["94", 1],
        "latent_image": ["94", 2],
        "seed": 0,
        "steps": 12,
        "cfg": 7.5,
        "sampler_name": "euler",
        "scheduler": "simple",
        "denoise": 1.0
      }
    },
    "92": {
      "class_type": "VaeDecodeShapeTrellis",
      "inputs": {
        "samples": ["23", 0],
        "vae": ["117", 0]
      }
    },
    "98": {
      "class_type": "Trellis2TextureStage",
      "inputs": {
        "positive": ["94", 0],
        "negative": ["94", 1],
        "shape_latent": ["23", 0]
      }
    },
    "12": {
      "class_type": "KSampler",
      "inputs": {
        "model": ["319", 0],
        "positive": ["98", 0],
        "negative": ["98", 1],
        "latent_image": ["98", 2],
        "seed": 0,
        "steps": 12,
        "cfg": 1.0,
        "sampler_name": "euler",
        "scheduler": "normal",
        "denoise": 1.0
      }
    },
    "118": {
      "class_type": "VAELoader",
      "inputs": {
        "vae_name": "trellis_2_texture_vae_bf16.safetensors"
      }
    },
    "93": {
      "class_type": "VaeDecodeTextureTrellis",
      "inputs": {
        "samples": ["12", 0],
        "vae": ["118", 0],
        "shape_subdivides": ["92", 1]
      }
    },
    "202": {
      "class_type": "GetMeshInfo",
      "inputs": {
        "mesh": ["92", 0]
      }
    },
    "241": {
      "class_type": "RemeshMesh",
      "inputs": {
        "mesh": ["202", 0],
        "resolution": 768,
        "sign_mode": "udf",
        "sign_mode.qef": false,
        "sign_mode.drop_inverted_components": false,
        "sign_mode.drop_enclosed_components": false,
        "band": 1.0,
        "project_back": 0.0,
        "fix_poles": false,
        "smooth_iters": 20,
        "drop_small_components": 0.01,
        "precluster_max_verts": 20000000
      }
    },
    "186": {
      "class_type": "DecimateMesh",
      "inputs": {
        "mesh": ["241", 0],
        "target_face_count": 50000,
        "placement_mode": "midpoint",
        "placement_mode.line_quadric_weight": 0.0,
        "placement_mode.feature_edge_quadric_weight": 0.0,
        "placement_mode.feature_edge_min_dihedral_deg": 30.0,
        "placement_mode.clamp_v_to_edge": true
      }
    },
    "238": {
      "class_type": "MeshSmoothNormals",
      "inputs": {
        "mesh": ["186", 0],
        "crease_angle": 180.0
      }
    },
    "288": {
      "class_type": "PrimitiveInt",
      "inputs": {
        "value": 2048
      }
    },
    "196": {
      "class_type": "UnwrapMesh",
      "inputs": {
        "mesh": ["238", 0],
        "segmenter": "pec",
        "resolution": ["288", 0],
        "padding": 1,
        "weld_distance": 0.0002
      }
    },
    "147": {
      "class_type": "BakeTextureFromVoxel",
      "inputs": {
        "mesh": ["196", 0],
        "voxel_colors": ["93", 0],
        "texture_size": ["288", 0],
        "reference_mesh": ["92", 0]
      }
    },
    "224": {
      "class_type": "BakeNormalMapFromMesh",
      "inputs": {
        "low_poly": ["196", 0],
        "high_poly": ["241", 0],
        "resolution": 2048,
        "cage_distance": 0.05,
        "ignore_backfaces": true
      }
    },
    "233": {
      "class_type": "BakeAmbientOcclusion",
      "inputs": {
        "low_poly": ["196", 0],
        "high_poly": ["241", 0],
        "resolution": 1024,
        "samples": 64,
        "max_distance": 0.71,
        "strength": 1.0,
        "bias": 0.01
      }
    },
    "210": {
      "class_type": "ApplyTextureToMesh",
      "inputs": {
        "mesh": ["196", 0],
        "base_color": ["147", 0],
        "metallic": ["147", 1],
        "roughness": ["147", 2],
        "occlusion": ["233", 0],
        "normal_map": ["224", 0]
      }
    },
    "260": {
      "class_type": "MeshSmoothNormals",
      "inputs": {
        "mesh": ["210", 0],
        "crease_angle": 180.0
      }
    },
    "900": {
      "class_type": "SaveGLB",
      "inputs": {
        "mesh": ["260", 0],
        "filename_prefix": "agenerela/mesh"
      }
    }
  }
}
