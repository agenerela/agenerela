# Settings for the Agenerela ComfyUI stack. Copy to .env next to this file;
# on the server, setup.ps1 does that and generates the token for you.
# .env is gitignored. Never paste the token into a commit, a chat or a URL.

# --- Both machines ------------------------------------------------------------
# Shared secret for the gateway: 64 hex characters. The server's .env and the
# client's .env must hold the same value.
COMFY_API_TOKEN=

# --- Server: the RTX 5080 machine ---------------------------------------------
# Web UI port, reachable from this machine's browser only. Another ComfyUI on
# the same machine usually sits on 8188 (portable) or 8000 (desktop app).
COMFY_UI_PORT=8288
# Gateway port other machines call.
COMFY_API_PORT=8289
# Address the gateway listens on. 0.0.0.0 means every network adapter. Put the
# machine's Tailscale or LAN address here to listen on that network only.
COMFY_API_BIND=0.0.0.0
# Folder for uploaded inputs, generated outputs and UI settings. Models are kept
# in a Docker volume instead (README, "Where things live").
COMFY_DATA_DIR=./data

# --- Client: the machine running Claude Code or Codex -------------------------
# The server's gateway, e.g. http://192.168.1.50:8289 (setup.ps1 prints the
# candidates).
COMFY_URL=
