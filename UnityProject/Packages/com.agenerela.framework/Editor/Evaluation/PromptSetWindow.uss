/*
 * The Prompt Set window's layout (#160, screen 8). Colour and type come from the kit's variables
 * in Agenerela.uss (#167), which follow the light and dark editor skins; nothing here sets a
 * colour of its own. The one theme file #160 asks for is that pair: the kit for how things look,
 * this file for where they go.
 */

.ps {
    flex-grow: 1;
}

/* Helpers */

.ps-row {
    flex-direction: row;
    align-items: center;
}

.ps-grow {
    flex-grow: 1;
    flex-shrink: 1;
}

.ps-shrink {
    flex-shrink: 1;
}

.ps-end {
    justify-content: flex-end;
}

.ps-wrap {
    white-space: normal;
}

.ps-bold {
    -unity-font-style: bold;
}

.ps-pad {
    padding: var(--ag-space-m) var(--ag-space-l);
}

.ps-pad-s {
    padding: var(--ag-space-s) var(--ag-space-m);
}

.ps-footnote {
    margin-top: var(--ag-space-m);
    font-size: var(--ag-font-size-small);
}

.ps-field-note {
    font-size: var(--ag-font-size-small);
    margin-left: 123px;
    margin-bottom: var(--ag-space-s);
}

.ps-scroll {
    flex-grow: 1;
}

.ps-scroll > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container {
    padding: var(--ag-space-s) var(--ag-space-l) var(--ag-space-l) var(--ag-space-l);
}

.ps-messages {
    padding: 0 var(--ag-space-l);
    flex-shrink: 0;
}

.ps-messages > .ag-problem {
    margin-top: var(--ag-space-s);
    margin-bottom: 0;
}

/* Toolbar: each label stays with its field, and the groups wrap instead of clipping (#159) */

.ps-toolbar {
    flex-wrap: wrap;
    flex-shrink: 0;
    height: auto;
    min-height: 21px;
}

.ps-toolbar__group {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 20px;
    margin-right: var(--ag-space-m);
}

.ps-toolbar__label {
    margin-left: var(--ag-space-s);
    margin-right: var(--ag-space-s);
    -unity-text-align: middle-left;
}

.ps-toolbar__object {
    width: 150px;
    margin: 0;
}

.ps-toolbar__name {
    width: 100px;
    margin: 0;
}

.ps-toolbar__names {
    width: 18px;
    min-width: 18px;
    padding-left: 2px;
    padding-right: 2px;
}

.ps-toolbar__reload {
    flex-shrink: 0;
}

/* Tabs and the line under them */

.ps-tabs {
    flex-shrink: 0;
}

.ps-tabs > .unity-toolbar-toggle {
    min-width: 72px;
    -unity-text-align: middle-center;
}

.ps-mode-line {
    flex-shrink: 0;
    font-size: var(--ag-font-size-small);
    padding: var(--ag-space-xs) var(--ag-space-l);
}

/* A · Start */

.ps-start {
    margin-top: var(--ag-space-m);
}

.ps-start__title {
    font-size: var(--ag-font-size-big);
    -unity-font-style: bold;
    margin-bottom: var(--ag-space-xs);
}

.ps-step {
    flex-direction: row;
    align-items: flex-start;
    margin-top: var(--ag-space-l);
}

.ps-step__mark {
    width: 22px;
    height: 22px;
    margin-right: var(--ag-space-m);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    border-width: 1px;
    border-radius: 11px;
    border-color: var(--ag-line);
    flex-shrink: 0;
}

.ps-step--done > .ps-step__mark {
    background-color: var(--ag-text);
    border-color: var(--ag-text);
    color: var(--ag-background);
}

.ps-step__title {
    -unity-font-style: bold;
    margin-bottom: var(--ag-space-xs);
}

.ps-step__detail {
    margin-bottom: var(--ag-space-s);
}

.ps-step__actions {
    flex-wrap: wrap;
    margin: var(--ag-space-s) 0;
}

.ps-step__actions > Button {
    margin-left: 0;
    margin-right: var(--ag-space-m);
    height: 24px;
    flex-shrink: 0;
}

/* B · Write */

.ps-write {
    flex-grow: 1;
    align-items: stretch;
}

.ps-write__list {
    width: 250px;
    flex-shrink: 0;
    border-right-width: 1px;
    border-color: var(--ag-line);
}

.ps-write__search {
    width: auto;
    margin: var(--ag-space-s);
}

.ps-write__new-category {
    padding: var(--ag-space-s);
    border-top-width: 1px;
    border-color: var(--ag-line);
    flex-shrink: 0;
}

.ps-write__side {
    min-width: 0;
}

.ps-category {
    flex-direction: row;
    align-items: center;
    height: 22px;
    padding: 0 var(--ag-space-m);
    background-color: var(--ag-surface);
    border-bottom-width: 1px;
    border-color: var(--ag-surface-line);
    -unity-font-style: bold;
}

.ps-category__arrow {
    width: 12px;
    color: var(--ag-text-muted);
}

.ps-category__count {
    margin-left: var(--ag-space-s);
    color: var(--ag-text-muted);
    -unity-font-style: normal;
}

.ps-category__changed {
    margin-left: auto;
    color: var(--ag-warning);
}

.ps-prompt {
    flex-direction: row;
    align-items: center;
    height: 20px;
    padding-left: 22px;
    padding-right: var(--ag-space-m);
    border-left-width: 2px;
    border-color: rgba(0, 0, 0, 0);
}

.ps-prompt:hover {
    background-color: var(--ag-surface);
}

.ps-prompt--selected,
.ps-prompt--selected:hover {
    background-color: var(--ag-surface);
    border-left-color: var(--ag-text);
}

.ps-prompt__id {
    -unity-font-definition: var(--ag-font-mono);
    font-size: var(--ag-font-size-small);
    width: 96px;
    flex-shrink: 0;
    overflow: hidden;
}

.ps-prompt__badge {
    color: var(--ag-warning);
    -unity-font-style: bold;
    width: 14px;
    flex-shrink: 0;
}

.ps-prompt__stimulus {
    color: var(--ag-text-muted);
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.ps-add-prompt {
    align-self: flex-end;
    margin: var(--ag-space-xs) var(--ag-space-m) var(--ag-space-s) 0;
}

.ps-editor {
    padding: var(--ag-space-m) var(--ag-space-l);
}

.ps-editor__title {
    font-size: var(--ag-font-size-big);
    margin-bottom: var(--ag-space-m);
}

.ps-editor__text > .unity-text-field__input {
    min-height: 40px;
    white-space: normal;
}

.ps-editor__pick {
    width: 18px;
    min-width: 18px;
    padding-left: 2px;
    padding-right: 2px;
}

.ps-editor__state-head {
    align-items: flex-start;
    margin: var(--ag-space-xs) 3px;
}

.ps-editor__state-label {
    min-width: 120px;
    width: 120px;
    padding-top: 2px;
}

.ps-editor__state-add {
    margin-bottom: var(--ag-space-s);
}

.ps-editor__small {
    width: 22px;
    flex-shrink: 0;
}

.ps-state-row {
    flex-direction: row;
    align-items: center;
}

.ps-state-row > Label {
    -unity-font-definition: var(--ag-font-mono);
    font-size: var(--ag-font-size-small);
    width: 110px;
    flex-shrink: 0;
}

.ps-state-row > .unity-base-field {
    flex-grow: 1;
    flex-shrink: 1;
}

.ps-target-row {
    flex-direction: row;
    align-items: center;
}

.ps-target-row > DropdownField {
    flex-grow: 1;
    flex-shrink: 1;
}

.ps-check {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--ag-space-xs);
}

.ps-check__mark {
    width: 16px;
    flex-shrink: 0;
    color: var(--ag-text-muted);
}

.ps-savebar {
    flex-shrink: 0;
}

.ps-savebar__state {
    -unity-text-align: middle-left;
    margin-left: var(--ag-space-m);
}

/* C · Label */

.ps-label__progress {
    margin-top: var(--ag-space-m);
    margin-bottom: var(--ag-space-m);
}

.ps-label__done {
    margin: var(--ag-space-m) 0;
}

.ps-label__card {
    margin-bottom: var(--ag-space-l);
}

.ps-label__speaker {
    font-size: var(--ag-font-size-small);
    -unity-font-style: bold;
    color: var(--ag-text-muted);
}

.ps-label__stimulus {
    font-size: var(--ag-font-size-big);
    margin-top: var(--ag-space-xs);
}

.ps-label__line {
    white-space: normal;
}

.ps-label__buttons {
    margin: var(--ag-space-m) 0 var(--ag-space-s) 0;
}

.ps-label__buttons > Button {
    height: 24px;
    min-width: 80px;
}

/* D · Agreement */

.ps-agreement__head {
    margin-top: var(--ag-space-m);
    align-items: flex-start;
}

.ps-agreement__big {
    font-size: 30px;
    -unity-font-style: bold;
    min-width: 72px;
    margin-right: var(--ag-space-l);
}

.ps-agreement__table {
    flex-shrink: 0;
    min-height: 60px;
}

.ps-bar {
    flex-direction: row;
    height: 8px;
    margin: 0 var(--ag-space-s);
    border-radius: var(--ag-radius);
    background-color: var(--ag-surface);
    border-width: 1px;
    border-color: var(--ag-surface-line);
    flex-grow: 1;
    align-self: center;
}

.ps-bar__fill {
    background-color: var(--ag-text-muted);
    border-radius: var(--ag-radius);
}

.ps-cell {
    -unity-text-align: middle-left;
    padding-left: var(--ag-space-s);
    overflow: hidden;
}

.ps-cell--number {
    -unity-text-align: middle-right;
    padding-right: var(--ag-space-s);
}

.ps-split {
    margin-top: var(--ag-space-s);
}

.ps-split__answer {
    flex-direction: row;
    margin-left: var(--ag-space-l);
}

.ps-split__who {
    width: 110px;
    flex-shrink: 0;
    color: var(--ag-text-muted);
}

.ps-split__buttons {
    flex-wrap: wrap;
    margin-top: var(--ag-space-s);
}

.ps-split__buttons > Button {
    margin-left: 0;
    margin-right: var(--ag-space-s);
}

.ps-agreement__every {
    margin-top: var(--ag-space-m);
}

/* The hosts the three views go into */

.ps-host {
    flex-grow: 1;
}

.ps-host > * {
    flex-grow: 1;
}
