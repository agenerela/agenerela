# =============================================================================
# Agenerela — Git attributes
#
# This file MUST stay the first thing committed to this repository. Line endings
# are normalised at `git add` time, so adding it later would require one enormous
# "changed every line of every file" commit that destroys `git blame`.
#
# Likewise, Git LFS only intercepts files committed AFTER a pattern is tracked.
# Add new binary patterns here BEFORE committing the first file of that type.
# =============================================================================

# --- Line endings ------------------------------------------------------------
# Normalise to LF inside the repository, convert to the native ending on
# checkout. Without this, a mixed Windows/macOS team gets CRLF churn on
# every commit.
* text=auto

*.cs        text diff=csharp
*.shader    text
*.cginc     text
*.hlsl      text
*.compute   text
*.json      text
*.md        text
*.txt       text
*.xml       text
*.yml       text
*.yaml      text
*.asmdef    text
*.asmref    text
*.uxml      text
*.uss       text
*.gbnf      text

# --- Unity YAML --------------------------------------------------------------
# Force LF and route conflicts through Unity's smart merge tool. The
# `merge=unityyamlmerge` driver must also be configured locally per machine;
# see docs/llm-wiki (setup) — without it Git falls back to a normal merge.
*.unity           merge=unityyamlmerge eol=lf
*.prefab          merge=unityyamlmerge eol=lf
*.asset           merge=unityyamlmerge eol=lf
*.mat             merge=unityyamlmerge eol=lf
*.anim            merge=unityyamlmerge eol=lf
*.controller      merge=unityyamlmerge eol=lf
*.overrideController merge=unityyamlmerge eol=lf
*.physicMaterial  merge=unityyamlmerge eol=lf
*.physicsMaterial2D merge=unityyamlmerge eol=lf
*.playable        merge=unityyamlmerge eol=lf
*.mask            merge=unityyamlmerge eol=lf
*.terrainlayer    merge=unityyamlmerge eol=lf
*.meta            text eol=lf

# --- Binary assets via Git LFS -----------------------------------------------
# NOTE: GitHub's free tier allows roughly 1 GB of LFS storage and 1 GB of
# bandwidth per month. Keep art proportionate; see the build plan.

# Images
*.png   filter=lfs diff=lfs merge=lfs -text
*.jpg   filter=lfs diff=lfs merge=lfs -text
*.jpeg  filter=lfs diff=lfs merge=lfs -text
*.gif   filter=lfs diff=lfs merge=lfs -text
*.bmp   filter=lfs diff=lfs merge=lfs -text
*.tga   filter=lfs diff=lfs merge=lfs -text
*.tif   filter=lfs diff=lfs merge=lfs -text
*.tiff  filter=lfs diff=lfs merge=lfs -text
*.psd   filter=lfs diff=lfs merge=lfs -text
*.exr   filter=lfs diff=lfs merge=lfs -text
*.hdr   filter=lfs diff=lfs merge=lfs -text

# 3D models
*.fbx   filter=lfs diff=lfs merge=lfs -text
*.obj   filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.dae   filter=lfs diff=lfs merge=lfs -text
*.3ds   filter=lfs diff=lfs merge=lfs -text

# Audio and video
*.wav   filter=lfs diff=lfs merge=lfs -text
*.mp3   filter=lfs diff=lfs merge=lfs -text
*.ogg   filter=lfs diff=lfs merge=lfs -text
*.aif   filter=lfs diff=lfs merge=lfs -text
*.aiff  filter=lfs diff=lfs merge=lfs -text
*.mp4   filter=lfs diff=lfs merge=lfs -text
*.mov   filter=lfs diff=lfs merge=lfs -text
*.webm  filter=lfs diff=lfs merge=lfs -text

# Fonts
*.ttf   filter=lfs diff=lfs merge=lfs -text
*.otf   filter=lfs diff=lfs merge=lfs -text

# Native libraries and packaged builds
*.dll   filter=lfs diff=lfs merge=lfs -text
*.so    filter=lfs diff=lfs merge=lfs -text
*.dylib filter=lfs diff=lfs merge=lfs -text
*.a     filter=lfs diff=lfs merge=lfs -text
*.bundle filter=lfs diff=lfs merge=lfs -text
*.unitypackage filter=lfs diff=lfs merge=lfs -text

# Model weights. A single .gguf is 1-3 GB, so this pattern must exist before
# anyone ever commits one. Preferred approach is NOT to commit models at all —
# let the developer download one at runtime (see the build plan, DR-001).
*.gguf  filter=lfs diff=lfs merge=lfs -text
*.onnx  filter=lfs diff=lfs merge=lfs -text
*.bin   filter=lfs diff=lfs merge=lfs -text
